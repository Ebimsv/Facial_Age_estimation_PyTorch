# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ─────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/

# ── Model weights & checkpoints ──────────────────────────────────────────────
# Tracked individually when needed; keep large binaries off GitHub
*.pt
*.pth
*.onnx
*.jit
*.bin

# Exception: keep the example checkpoint referenced in README
# !checkpoints/example_checkpoint.pt

# ── Dataset images (large binary files — never commit) ──────────────────────
# The leading / anchors to repo root only, so src/data/ is NOT affected.
/dataset/
/data/

# ── Generated CSV files (small, useful to commit for reproducibility) ────────
# csv_dataset/ is intentionally NOT listed here so the split CSVs are tracked.
# Uncomment the line below if you prefer users to generate their own splits:
# /csv_dataset/

# ── Logging & experiment tracking ────────────────────────────────────────────
runs/
wandb/
mlruns/
*.log
logs/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── IDE & OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Ruff / pre-commit cache ───────────────────────────────────────────────────
.ruff_cache/
.pre-commit-cache/

# ── Pytest ───────────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Secrets ──────────────────────────────────────────────────────────────────
kaggle.json
kaggle*.json
access_token
.kaggle/
.env.local
secrets.yaml
